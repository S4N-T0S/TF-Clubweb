/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' https://api.ogclub.s4nt0s.eu https://docs.google.com https://*.googleusercontent.com; font-src 'self' data: https:; frame-ancestors 'none';
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Cache all assets, immutable. On build, a new hash is generated so this does not break anything.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vault art, immutable for a year: a changed file needs a new name, a deleted name is never reused.
# Regenerated data (usb ids, GeoIP, world geometry) lives in src/vault/assets with ?url imports, so Vite hashes it.
/vault/*
  Cache-Control: public, max-age=31536000, immutable

# Historical season data, brotli-11 at build time (tools/vite-historical-data.js)
/data/*.bin
  Content-Encoding: br
  Content-Type: application/json
  Vary: Accept-Encoding
  Cache-Control: public, max-age=31536000, immutable, no-transform
